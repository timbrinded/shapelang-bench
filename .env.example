# All variables are optional — every one has a working default.

# Bun binary used to install/run generated candidates (default: "bun" on PATH).
#BUN_BIN=/path/to/bun

# Review benchmark: judge + reviewer engines (Codex model names).
# Defaults: gpt-5.5 / gpt-5.5 (see review-bench/config.ts).
#JUDGE_MODEL=gpt-5.5
#REVIEW_MODEL=gpt-5.5

# Concurrent judge calls during scoring (default 6).
#JUDGE_CONCURRENCY=6

# Per-review agent timeout in ms (default 1800000 = 30 min).
#REVIEW_TIMEOUT_MS=1800000

# Codex subscription auth.json to copy for the judge (default ~/.codex/auth.json).
#CODEX_AUTH_FILE=/home/you/.codex/auth.json
